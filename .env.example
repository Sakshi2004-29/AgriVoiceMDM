# ==============================================================================
# Environment Configuration - Voice-First Multilingual Agricultural Assistant
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# 1. AI Model Provider (Google Gemini API)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Live Mandi Market Prices (Data.gov.in / Agmarknet API - Optional)
# Register and generate a free API key at: https://data.gov.in
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# 3. Weather API Configuration
# Open-Meteo is open and requires no API key.
# Optional fallback weather key (e.g., OpenWeatherMap):
WEATHER_API_KEY=your_openweather_api_key_here

# 4. WhatsApp Business Cloud API Configuration (Meta Cloud API - Optional)
# Obtain from Meta for Developers: https://developers.facebook.com/apps/
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=agri_assistant_verify_token
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v19.0

# 5. Twilio WhatsApp Sandbox Configuration (Twilio Sandbox - Active)
# Obtain from Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=whatsapp:+14155238886
# Optional: your public tunnel webhook URL for strict signature verification (e.g. https://xxx.ngrok-free.app/twilio/webhook)
TWILIO_WEBHOOK_URL=

# 6. Admin Console Authentication (Module 14)
# Default credentials: admin / admin@agri2026
ADMIN_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin@agri2026

# 6. Language Settings
# Supported language codes: hi (Hindi), mr (Marathi), en (English)
DEFAULT_INPUT_LANGUAGE=hi
DEFAULT_OUTPUT_LANGUAGE=hi

# 7. Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
AUDIO_RECORD_SECONDS=5
